parameters:
    level: 5
    paths:
        - ../app
        - ../bin
        - ../maint
        - ../www
    # One-off scripts are a record of what was run, not maintained code
    excludePaths:
        - ../maint/oneoff

    # Defines bclog(), cliOption(), dollars() and the autoloader used by every script
    bootstrapFiles:
        - ../app/common.php

    # Don't report unmatched ignored errors
    reportUnmatchedIgnoredErrors: false

